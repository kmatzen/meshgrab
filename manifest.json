{
  "manifest_version": 3,
  "name": "MeshGrab — WebGL geometry inspector",
  "version": "1.1.1",
  "description": "Capture WebGL vertex buffers and textures at upload time, classify the attributes, and export a glTF 2.0 binary.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "MeshGrab",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
